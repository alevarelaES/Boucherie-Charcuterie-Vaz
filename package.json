{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "npm run generate:sitemap && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "extract-i18n": "i18next-parser",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "optimize:images": "node scripts/auto-optimize-images.js",
    "check:i18n": "node scripts/check-i18n.js",
    "check:mobile": "node scripts/check-mobile-perf.js",
    "check:seo": "node scripts/check-seo.js",
    "check:all": "npm run check:i18n && npm run check:mobile && npm run check:seo",
    "fullpush": "node scripts/fullpush.js",
    "prebuild": "npm run optimize:images && npm run generate:sitemap"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.1.2",
    "@sanity/client": "^7.14.0",
    "@sanity/image-url": "^2.0.3",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "^17.2.3",
    "embla-carousel-react": "8.6.0",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^16.5.2",
    "react-router-dom": "^7.12.0",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.6",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^4.0.17",
    "i18next-parser": "^9.3.0",
