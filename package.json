    "sharp": "^0.34.5",
    "tailwindcss": "4.1.12",
    "vite": "^6.4.1",
    "vite-plugin-compression2": "^2.4.0",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
